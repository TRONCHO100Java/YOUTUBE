# ------------------------------------------------------------------ secretos
.env
.env.local
.env.*.local
!.env.example

# -------------------------------------------------------------------- python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------- node
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*

# ------------------------------------------------------------------- storage
# Lo que hay dentro pesa gigas y se regenera solo: videos descargados, audio,
# clips y transcripciones. La ESTRUCTURA si se versiona —con .gitkeep— para que
# al clonar el proyecto arranque sin tener que crear las carpetas a mano.
storage/*
!storage/.gitkeep
!storage/projects/
!storage/export/
storage/projects/*
storage/export/*
!storage/projects/.gitkeep
!storage/export/.gitkeep

# --------------------------------------------------------------------- otros
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# Estado local de celery beat: cuando disparo cada tarea por ultima vez.
# Es de esta maquina y de este momento, no del proyecto.
celerybeat-schedule*
celerybeat.pid
