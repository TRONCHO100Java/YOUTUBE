# Normaliza finales de linea: LF en el repositorio, nativo en el working copy.
* text=auto eol=lf

# Los scripts de PowerShell y los .bat se ejecutan en Windows.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binarios.
*.png binary
*.jpg binary
*.ico binary
*.mp4 binary
*.woff2 binary
