# =============================================================================
# ClipForge - configuracion de desarrollo local
# Copia este fichero a `.env` y ajusta lo que necesites. `.env` NO se sube a git.
# =============================================================================

# ---------------------------------------------------------------- general ---
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console          # console | json

# ------------------------------------------------------------ persistencia ---
# Credenciales del contenedor Postgres (las lee docker-compose).
POSTGRES_USER=clipforge
POSTGRES_PASSWORD=clipforge
POSTGRES_DB=clipforge
POSTGRES_PORT=5442
REDIS_PORT=6390

# URL canonica (sin driver): el backend deriva psycopg (worker/alembic) y asyncpg (API).
DATABASE_URL=postgresql://clipforge:clipforge@localhost:5442/clipforge
DB_ECHO=false
REDIS_URL=redis://localhost:6390/0

# ------------------------------------------------------------------- api ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --------------------------------------------------------------- storage ---
# Vacio = <raiz del repo>/storage
# STORAGE_PATH=
KEEP_SOURCE_VIDEO=false
KEEP_AUDIO=false
KEEP_TEMP_FILES=false

# --------------------------------------------------------------- fuentes ---
ALLOWED_SOURCE_HOSTS=youtube.com,www.youtube.com,m.youtube.com,music.youtube.com,youtu.be
MAX_SOURCE_DURATION_SECONDS=14400
MAX_SOURCE_FILESIZE_MB=4096

# ------------------------------------------------------------ multimedia ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_FORMAT=bestvideo[height<=1080]+bestaudio/best[height<=1080]/best
VIDEO_ENCODER=auto          # auto | h264_nvenc | libx264
VIDEO_BITRATE=8M
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920

# --------------------------------------------------------------- whisper ---
WHISPER_MODEL=large-v3      # tiny | base | small | medium | large-v3 (usa small en pruebas)
WHISPER_DEVICE=cuda         # cuda | cpu | auto
WHISPER_COMPUTE_TYPE=float16
WHISPER_BEAM_SIZE=5
# WHISPER_LANGUAGE=es       # vacio = deteccion automatica
WHISPER_WORD_TIMESTAMPS=true

# -------------------------------------------------------------------- ia ---
AI_PROVIDER=openai          # openai | anthropic | ollama | mock
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
AI_MAX_RETRIES=3
AI_REQUEST_TIMEOUT_SECONDS=120

# ----------------------------------------------------------------- clips ---
MAX_CLIPS_PER_PROJECT=5
MIN_CLIP_DURATION=20
MAX_CLIP_DURATION=90
TARGET_CLIP_DURATION=45
ANALYSIS_CHUNK_SECONDS=300
ANALYSIS_CHUNK_OVERLAP_SECONDS=60
BURN_SUBTITLES=true

# ---------------------------------------------------------------- worker ---
CELERY_TASK_TIME_LIMIT=10800
CELERY_TASK_SOFT_TIME_LIMIT=10500
CELERY_WORKER_CONCURRENCY=1

# -------------------------------------------------------------- frontend ---
# Se copia tambien a apps/web/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000
