# =============================================================================
# ClipForge - configuracion de desarrollo local
# Copia este fichero a `.env` y ajusta lo que necesites. `.env` NO se sube a git.
# =============================================================================

# ---------------------------------------------------------------- general ---
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console          # console | json

# ------------------------------------------------------------ persistencia ---
# Credenciales del contenedor Postgres (las lee docker-compose).
POSTGRES_USER=clipforge
POSTGRES_PASSWORD=clipforge
POSTGRES_DB=clipforge
POSTGRES_PORT=5442
REDIS_PORT=6390

# URL canonica (sin driver): el backend deriva psycopg (worker/alembic) y asyncpg (API).
DATABASE_URL=postgresql://clipforge:clipforge@localhost:5442/clipforge
DB_ECHO=false
REDIS_URL=redis://localhost:6390/0

# ------------------------------------------------------------------- api ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --------------------------------------------------------------- storage ---
# Vacio = <raiz del repo>/storage
# STORAGE_PATH=
# El original se conserva: hace falta para recortar los clips y para
# reprocesar sin volver a descargar. Ponlo a false si te falta disco.
KEEP_SOURCE_VIDEO=true
KEEP_AUDIO=false
KEEP_TEMP_FILES=false

# --------------------------------------------------------------- fuentes ---
ALLOWED_SOURCE_HOSTS=youtube.com,www.youtube.com,m.youtube.com,music.youtube.com,youtu.be
MAX_SOURCE_DURATION_SECONDS=14400
MAX_SOURCE_FILESIZE_MB=4096

# ------------------------------------------------------------ multimedia ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Prioriza H.264 + AAC: mejor base para cortar y renderizar con NVENC.
YTDLP_FORMAT=bestvideo[vcodec^=avc1][height<=1080]+bestaudio[acodec^=mp4a]/bestvideo[height<=1080]+bestaudio/best[height<=1080]/best
VIDEO_ENCODER=auto          # auto | h264_nvenc | libx264
VIDEO_BITRATE=8M
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920

# ----------------------------------------------------------------- audio ---
# Iguala el volumen de todos los clips al estandar de audio social. Medido
# sobre tres videos de YouTube, los tramos sin tratar daban -12,5, -13,7 y
# -19,8 LUFS: siete decibelios entre el mas fuerte y el mas flojo.
AUDIO_NORMALIZE=true
AUDIO_TARGET_LUFS=-14
AUDIO_TRUE_PEAK=-1.5
# Entrada corta para quitar el chasquido de cortar a mitad de onda; salida
# mas larga porque un corte brusco al final se oye como un fallo.
AUDIO_FADE_IN_SECONDS=0.08
AUDIO_FADE_OUT_SECONDS=0.35

# -------------------------------------------------------------- encuadre ---
# Coloca la ventana vertical sobre el sujeto en lugar de centrarla. Busca la
# franja del fotograma con mas caras y mas movimiento; en un plano general de
# dos personas, centrar deja a una fuera.
SMART_CROP=true
SMART_CROP_ANALYSIS_WIDTH=480
SMART_CROP_SAMPLE_FPS=2
SMART_CROP_MAX_SAMPLES=90
SMART_CROP_SMOOTHING=5
# Paneo: la ventana sigue al sujeto en lugar de quedarse fija. Funciona, pero
# va desactivado por defecto porque una camara que se mueve sola no le sienta
# bien a todo el material. Pruebalo con un video de accion.
SMART_CROP_PAN=false
SMART_CROP_PAN_RATIO=0.6
SMART_CROP_MAX_KEYFRAMES=12

# --------------------------------------------------------------- whisper ---
WHISPER_MODEL=large-v3      # tiny | base | small | medium | large-v3 (usa small en pruebas)
WHISPER_DEVICE=cuda         # cuda | cpu | auto
WHISPER_COMPUTE_TYPE=float16
WHISPER_BEAM_SIZE=5
# WHISPER_LANGUAGE=es       # vacio = deteccion automatica
WHISPER_WORD_TIMESTAMPS=true
# Descarta silencios y música: más rápido y evita alucinaciones sin voz.
WHISPER_VAD_FILTER=true
# transcribe mantiene el idioma original; translate devuelve ingles, que es
# lo unico que un LLM puede razonar en un video en bengali o hindi.
WHISPER_TASK=transcribe   # transcribe | translate
# Sin esto Whisper arrastra su propia salida y entra en bucle sobre musica.
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false

# -------------------------------------------------------------------- ia ---
# ollama es el defecto: local, gratis y sin enviar la transcripción a un tercero.
AI_PROVIDER=ollama          # ollama | openai | anthropic
AI_MODEL=qwen2.5:14b        # gpt-4o-mini para openai, claude-opus-5 para anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
AI_MAX_RETRIES=3
AI_REQUEST_TIMEOUT_SECONDS=120

# --- vision: para los videos que no se pueden juzgar por lo que dicen ---
AI_VISION_ENABLED=true
# Vacio = mismo proveedor que AI_PROVIDER.
# AI_VISION_PROVIDER=
# Local y gratis: `ollama pull qwen2.5vl:7b`. Para calidad de verdad,
# claude-opus-5 o gpt-4o-mini con AI_VISION_PROVIDER a juego.
AI_VISION_MODEL=qwen2.5vl:7b
VISION_FRAMES_PER_BLOCK=5
VISION_MAX_BLOCKS=15
# Un bloque por peticion: con mas, un modelo de 7B deja de distinguirlos y
# devuelve el mismo titulo para todos. Subelo solo con un modelo grande.
VISION_BLOCKS_PER_REQUEST=1

# ------------------------------------------------------------ publicacion ---
# Subir a YouTube desde la app. Esto SI necesita credenciales, y conviene
# saber el muro antes de montarlo: la API de datos de YouTube restringe a
# PRIVADO todo lo que sube un proyecto de Google Cloud sin auditar. El video
# sube con su titulo y su descripcion puestos, pero hay que entrar a
# publicarlo. Con la auditoria aprobada, cambia YOUTUBE_PRIVACY a public.
#
# 1. Proyecto en https://console.cloud.google.com con "YouTube Data API v3"
# 2. Credenciales -> ID de cliente OAuth -> Aplicacion de escritorio
# 3. pip install -e .[publish]   (dentro de apps/backend)
# 4. python -m clipforge.services.publish.authorize   (una sola vez)
# YOUTUBE_CLIENT_SECRETS_FILE=C:/ruta/client_secrets.json
# YOUTUBE_TOKEN_FILE=C:/ruta/youtube_token.json
YOUTUBE_PRIVACY=private     # private | unlisted | public

# --------------------------------------------------------------- ingesta ---
# Los videos ya no hay que ir a buscarlos: la app busca en YouTube y vigila
# canales. Ninguna de las dos cosas usa la API de datos de YouTube, asi que no
# hay clave que poner ni cuota que se agote: buscar lo hace yt-dlp y vigilar es
# leer el RSS publico del canal.
INGEST_ENABLED=true
# Cada cuanto se leen los RSS de los canales vigilados. Son GET de 0,3 s sin
# cuota, asi que bajarlo no cuesta nada.
INGEST_INTERVAL_MINUTES=30
# Tope de videos que un canal puede encolar en una sola revision. Un canal que
# publica quince de golpe no debe convertirse en quince descargas.
INGEST_MAX_PER_CHECK=3
# Resultados por busqueda en la interfaz.
SEARCH_RESULTS=12

# --------------------------------------------------------------- titulos ---
# El titulo que sale del analisis es un subproducto: ese modelo esta puntuando
# siete dimensiones y lo escribe de paso, asi que describe la escena en vez de
# dar ganas de abrirla. Esta pasada lo reescribe sobre los clips ya elegidos.
TITLES_ENABLED=true
# Donde corta el movil en el feed y en la busqueda de Shorts.
TITLE_MAX_CHARS=60
# Variantes por clip. Con varias, el validador tiene recambio cuando una se
# pasa de larga, repite el arranque de otra o cae en un topico.
TITLE_VARIANTS=3
# Vacios = los mismos que AI_PROVIDER y AI_MODEL. Merece la pena apuntar esto
# a una API aunque el analisis corra en local: es UNA llamada por proyecto, y
# es el texto que decide si alguien abre el clip. Un 14B local escribe titulos
# correctos pero descriptivos; un modelo grande escribe titulos que se pulsan.
# AI_TITLE_PROVIDER=anthropic
# AI_TITLE_MODEL=claude-opus-5

# ------------------------------------------------- perfil de contenido ---
# auto decide por video: si casi no hay habla, se juzga por lo que OCURRE.
CONTENT_PROFILE=auto        # auto | talking | visual
VISUAL_SPEECH_RATIO=0.25
VISUAL_CHARS_PER_MINUTE=200
# Por debajo de esto la transcripcion se considera alucinada y se descarta.
MIN_USABLE_SPEECH_RATIO=0.02

# ----------------------------------------------------------------- clips ---
MAX_CLIPS_PER_PROJECT=5

# Carpeta con los clips renombrados por su titulo, lista para subirlos.
# EXPORT_PATH=            # por defecto <STORAGE_PATH>/export; admite ruta absoluta
EXPORT_CLIPS=true
MIN_CLIP_DURATION=20
MAX_CLIP_DURATION=90
TARGET_CLIP_DURATION=45
# Duraciones del perfil visual: un gag se agota antes que una explicacion.
VISUAL_MIN_CLIP_DURATION=10
VISUAL_MAX_CLIP_DURATION=60
VISUAL_TARGET_CLIP_DURATION=25
ANALYSIS_CHUNK_SECONDS=300
ANALYSIS_CHUNK_OVERLAP_SECONDS=60
BURN_SUBTITLES=true
# Escribe el gancho del clip arriba, en los primeros segundos. Es lo unico
# escrito que lleva un clip sin dialogo, y donde se decide si alguien sigue
# mirando. Se puede editar clip a clip desde el editor.
HOOK_OVERLAY=true
HOOK_OVERLAY_SECONDS=3
HOOK_FONT_SIZE=100
HOOK_LINE_LENGTH=18

# --------------------------------------------------------------- senales ---
# Volumen, cortes de plano y movimiento. Alimentan el analisis visual Y la
# linea de tiempo del editor manual, asi que se miden en todos los proyectos:
# sobre un video de nueve minutos cuestan unos 35 segundos.
SIGNALS_ENABLED=true
SIGNAL_ENERGY_INTERVAL_SECONDS=0.5
SIGNAL_SCENE_THRESHOLD=0.35
SIGNAL_PEAK_MIN_GAP_SECONDS=8
# La curva de movimiento cuesta como la de cortes; quitala si vas justo de CPU.
SIGNAL_MEASURE_MOTION=true

# ---------------------------------------------------------------- worker ---
CELERY_TASK_TIME_LIMIT=10800
CELERY_TASK_SOFT_TIME_LIMIT=10500
CELERY_WORKER_CONCURRENCY=1

# -------------------------------------------------------------- frontend ---
# Se copia tambien a apps/web/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000
